{
  "name": "ats-resume-optimizer",
  "version": "1.0.0",
  "description": "Local-first ATS Resume Optimizer & Job Tracker powered by Bun, Hono, Drizzle SQLite, and Mathematical NLP",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "cheerio": "^1.0.0",
    "docx": "^9.2.0",
    "drizzle-orm": "^0.40.0",
    "franc": "^6.2.0",
    "hono": "^4.7.2",
    "leven": "^4.0.0",
    "natural": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "latest",
    "@types/natural": "^5.1.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.13.9"
  }
