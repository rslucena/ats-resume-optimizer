# Server Port (Default: 3000)
PORT=3000

# SQLite Database Path (Default: data/ats_tracker.sqlite)
DB_PATH=data/ats_tracker.sqlite

# Optional Gemini AI API Key for LLM-powered resume tailoring fallback
GEMINI_API_KEY=

# Optional Anthropic Claude API Key for advanced resume tailoring and cover letters
# (Accepts ANTHROPIC_API_KEY or CLAUDE_API_KEY)
ANTHROPIC_API_KEY=
# Optional: Claude model (Default: claude-3-5-sonnet-20241022)
# Examples: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional OpenRouter API Key for multi-LLM access (https://openrouter.ai/)
OPENROUTER_API_KEY=
# Optional: OpenRouter model (Default: anthropic/claude-3.5-sonnet)
# Examples: anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional Local LLM via Ollama (100% offline & private)
# Define OLLAMA_BASE_URL to enable Ollama integration (e.g. http://localhost:11434)
OLLAMA_BASE_URL=
# Optional: Local model to use for tailoring and cover letters (Default: llama3.2)
# Examples: llama3.2, mistral, gemma2, qwen2.5, deepseek-r1:8b
OLLAMA_MODEL=
